# A small directed graph: a path a -> b -> c -> d, x on its own, and a
# weight on every node.
#: edge(from, to)
#: node(name)
#: weight(node, w)
edge("a", "b")
edge("b", "c")
edge("c", "d")
node("a")
node("b")
node("c")
node("d")
node("x")
weight("a", 1)
weight("b", 2)
weight("c", 3)
weight("d", 4)
weight("x", 5)
